<?xml version="1.0" encoding="utf-8"?>
<!--
    Release policy: HTTPS only.

    The debug variant overrides this file with one that also permits cleartext
    to local development hosts, so a locally run backend can be used without
    weakening shipped builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
