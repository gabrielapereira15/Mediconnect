<?xml version="1.0" encoding="utf-8"?>
<!--
    The four top-level destinations.

    The app previously had three tabs and a drawer holding Profile, Forms,
    Settings and Logout — so the health record was three taps deep and the
    way out of the app was hidden behind a hamburger. These four are the
    whole of the patient app's navigation; everything else is reached from
    inside one of them.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/home_fragment"
        android:icon="@drawable/nav_icon_home"
        android:title="@string/nav_home" />
    <item
        android:id="@+id/visits_fragment"
        android:icon="@drawable/nav_icon_calendar"
        android:title="@string/nav_visits" />
    <item
        android:id="@+id/health_fragment"
        android:icon="@drawable/nav_icon_record"
        android:title="@string/nav_health" />
    <item
        android:id="@+id/profile_fragment"
        android:icon="@drawable/nav_icon_user"
        android:title="@string/nav_profile" />
</menu>
