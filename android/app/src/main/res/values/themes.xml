<?xml version="1.0" encoding="utf-8"?>
<!--
    The theme previously set only a font. Every Material 3 colour attribute was
    left at the library default, so components ignored the palette entirely —
    which is why the toolbar, the buttons and the nav bar each looked like they
    came from a different app. Mapping the roles here means components pick up
    the palette, in both light and dark, on their own.

    The values themselves live in values/colors.xml and are overridden wholesale
    by values-night/colors.xml.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Mediconnectandroid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_sunken</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Status -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>

        <!-- Chips are built in code, so the style has to arrive by theme. -->
        <item name="chipStyle">@style/Widget.Mediconnect.Chip</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Mediconnect.BottomSheet</item>

        <!-- Selection, ripples and the focus ring all follow brand. -->
        <item name="android:colorControlActivated">@color/md_primary</item>
        <item name="android:colorControlHighlight">@color/md_primary_container</item>
        <!-- md_scrim is applied by sheets and dialogs themselves; there is no
             theme attribute for it. -->

        <!-- System bars follow the app rather than staying a stock purple. -->
        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography: Plus Jakarta Sans, declared as a family so a style
             can ask for a weight and Android picks the file. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Mediconnect.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Mediconnect.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Mediconnect.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Mediconnect.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Mediconnect.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Mediconnect.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Mediconnect.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Mediconnect.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Mediconnect.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Mediconnect.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Mediconnect.LabelSmall</item>

        <!-- Rounded corners throughout, matching the card-based layouts. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Mediconnect.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Mediconnect.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Mediconnect.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Mediconnect.ExtraLarge</item>

        <item name="materialButtonStyle">@style/Widget.Mediconnect.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.Mediconnect.BottomNav</item>
    </style>

    <style name="Theme.Mediconnectandroid" parent="Base.Theme.Mediconnectandroid" />

    <!--
        A bottom sheet.

        Its dialog is themed separately from the activity, so the app's own
        colours and control styles have to be handed to it explicitly or the
        sheet quietly reverts to Material's defaults.
    -->
    <style name="ThemeOverlay.Mediconnect.BottomSheet"
        parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="materialButtonStyle">@style/Widget.Mediconnect.Button</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
    </style>

    <!--
        Filter and navigation chips.

        Material's own filter chip fills with the secondary container, which
        here is the blue used for links — a selected specialty then reads as
        a different kind of control. Selected chips fill with brand instead.
    -->
    <style name="Widget.Mediconnect.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="chipMinHeight">@dimen/control_md</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Mediconnect.LabelLarge</item>
        <item name="rippleColor">@color/md_primary_container</item>
    </style>

    <!-- ==== Shape ========================================================= -->
    <style name="ShapeAppearance.Mediconnect.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.Mediconnect.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeAppearance.Mediconnect.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <!-- Bottom sheets and the home hero. -->
    <style name="ShapeAppearance.Mediconnect.ExtraLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xlarge</item>
    </style>

    <!-- ==== Components ==================================================== -->
    <style name="Widget.Mediconnect.Button" parent="Widget.Material3.Button">
        <!-- control-lg: the design system's size for a primary mobile button. -->
        <item name="android:minHeight">@dimen/control_lg</item>
        <item name="android:paddingStart">@dimen/space_2xl</item>
        <item name="android:paddingEnd">@dimen/space_2xl</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Mediconnect.LabelLarge</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="iconSize">@dimen/icon_size_button</item>
    </style>

    <!--
        The active tab's pill. Material 3 fills it with secondaryContainer by
        default, which in this palette is information blue — the design
        system gives the nav pill brand-soft, so it is set explicitly.
    -->
    <style name="Widget.Mediconnect.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Mediconnect.BottomNav.Indicator</item>
        <item name="itemIconSize">@dimen/icon_size</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Mediconnect.LabelSmall</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Mediconnect.LabelSmall</item>
    </style>

    <style name="Widget.Mediconnect.BottomNav.Indicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/md_primary_container</item>
    </style>

    <!--
        A secondary button. Material 3's tonal button fills with
        secondaryContainer, which this palette reserves for information, so
        it would come out a flat blue beside a teal primary. The design
        system's secondary button is brand-soft with on-brand-soft text.
    -->
    <style name="Widget.Mediconnect.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/control_lg</item>
        <item name="android:paddingStart">@dimen/space_2xl</item>
        <item name="android:paddingEnd">@dimen/space_2xl</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Mediconnect.LabelLarge</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
        <item name="backgroundTint">@color/md_primary_container</item>
        <item name="iconTint">@color/md_on_primary_container</item>
        <item name="iconSize">@dimen/icon_size_button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!--
        One segment of a segmented control (Appearance on Profile, the
        Visits filter). Same reason as the nav pill: Material reaches for
        secondaryContainer, and here that means "information".
    -->
    <style name="Widget.Mediconnect.Button.Segmented" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/control_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Mediconnect.LabelMedium</item>
        <item name="android:textColor">@color/segmented_button_text</item>
        <item name="backgroundTint">@color/segmented_button_background</item>
        <item name="iconTint">@color/segmented_button_text</item>
        <item name="strokeColor">@color/md_outline</item>
    </style>

    <!-- A text button: brand label, no fill. -->
    <style name="Widget.Mediconnect.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Mediconnect.LabelLarge</item>
        <item name="android:textColor">@color/md_primary</item>
        <item name="iconTint">@color/md_primary</item>
        <item name="iconSize">@dimen/icon_size_button</item>
    </style>
</resources>
