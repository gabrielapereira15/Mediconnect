<?xml version="1.0" encoding="utf-8"?>
<!--
    Spacing, shape and control sizes — the 2026 redesign scale.

    The design system names these space-1 … space-16 by their step on the 4dp
    grid. The existing t-shirt names stay as the primary spelling because the
    layouts already use them, with the design-system name beside each so a
    mockup's `space-5` can be found without a conversion table.
-->
<resources>

    <!-- ==== Spacing (4dp grid) ============================================ -->
    <!-- space-1 · icon-to-text gap inside chips and badges -->
    <dimen name="space_xs">4dp</dimen>
    <!-- space-2 · related items: chips in a row, label to field -->
    <dimen name="space_sm">8dp</dimen>
    <!-- space-3 · gap between cards in a list; compact row padding -->
    <dimen name="space_md">12dp</dimen>
    <!-- space-4 · screen side margin; card padding -->
    <dimen name="space_lg">16dp</dimen>
    <!-- space-5 · padding on roomy cards (hero, booking summary) -->
    <dimen name="space_xl">20dp</dimen>
    <!-- space-6 · gap between sections on a screen -->
    <dimen name="space_2xl">24dp</dimen>
    <!-- space-8 · large section breaks -->
    <dimen name="space_3xl">32dp</dimen>
    <!-- space-10 · top of empty states -->
    <dimen name="space_4xl">40dp</dimen>
    <!-- space-12 -->
    <dimen name="space_5xl">48dp</dimen>
    <!-- space-16 · onboarding hero spacing -->
    <dimen name="space_6xl">64dp</dimen>

    <!--
        The previous scale had space_xl = 24dp and space_2xl = 32dp. The
        design system puts 20dp between them, so both shift up one step.
        Layouts written against the old names keep working; they simply pick
        up the redesign's rhythm.
    -->

    <!-- ==== Corner radii ================================================== -->
    <!-- radius-xs · badges, checkboxes, table tags -->
    <dimen name="radius_xs">6dp</dimen>
    <!-- radius-sm · inputs, time slots, small buttons, menu items -->
    <dimen name="radius_small">10dp</dimen>
    <!-- radius-md · non-pill buttons, list-row highlights, panels -->
    <dimen name="radius_medium">14dp</dimen>
    <!-- radius-lg · cards, booking summary, dialogs -->
    <dimen name="radius_large">20dp</dimen>
    <!-- radius-xl · bottom sheets (top corners), the home hero card -->
    <dimen name="radius_xlarge">28dp</dimen>
    <!-- radius-full · primary buttons, chips, avatars, the nav pill -->
    <dimen name="radius_pill">999dp</dimen>

    <!-- ==== Control sizes ================================================= -->
    <!-- Minimum tap target for anything tappable. -->
    <dimen name="touch_target">48dp</dimen>
    <!-- control-lg · primary buttons and text fields -->
    <dimen name="control_lg">52dp</dimen>
    <!-- control-md · secondary buttons -->
    <dimen name="control_md">40dp</dimen>
    <!-- control-sm · filter chips -->
    <dimen name="control_sm">32dp</dimen>

    <!-- ==== Depth =========================================================
         Quiet: a hairline border carries the edge and the shadow only lifts.
         shadow-1 cards · shadow-2 sticky footers and bottom nav ·
         shadow-3 sheets and dialogs.
    -->
    <dimen name="elevation_card">1dp</dimen>
    <dimen name="elevation_raised">3dp</dimen>
    <dimen name="elevation_sheet">8dp</dimen>

    <!-- Hairlines and control borders. -->
    <dimen name="stroke_hairline">1dp</dimen>
    <dimen name="stroke_control">1dp</dimen>
    <!-- The focus ring: 2dp wide, 2dp clear of the control. -->
    <dimen name="focus_ring_width">2dp</dimen>
    <dimen name="focus_ring_offset">2dp</dimen>

    <!-- Icon sizes: 24 on its own, 20 in a button, 16 in a badge. -->
    <dimen name="icon_size">24dp</dimen>
    <dimen name="icon_size_button">20dp</dimen>
    <dimen name="icon_size_badge">16dp</dimen>

    <!-- Enough room below a list for a floating action button to clear it. -->
    <dimen name="space_fab_clearance">96dp</dimen>

    <!-- One day in the booking screen's date strip. -->
    <dimen name="date_chip_width">60dp</dimen>
    <dimen name="icon_size_small">20dp</dimen>
    <!-- Big enough to tap comfortably and to read at a glance. -->
    <dimen name="review_star_size">48dp</dimen>
</resources>
