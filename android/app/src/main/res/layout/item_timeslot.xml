<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_xs"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <!-- Date -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/date_slot_thu_8_jun"
        android:textColor="@color/dark_gray"
        android:textStyle="bold" 
        android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

    <!--
        Time slots.

        Was a GridLayout pinned to four columns, which clipped anything wider
        than a quarter of the screen — and the slot labels grew when the API
        started including minutes. A ChipGroup wraps to as many rows as it
        needs, sizes each chip to its own text, and handles single selection.
    -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_timeslots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        app:singleSelection="true"
        app:selectionRequired="false" />

</LinearLayout>
