<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    tools:context=".fragment.EditProfileFragment">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/space_lg">

        <!-- Patient Profile -->
        <LinearLayout
            android:id="@+id/layout_patient_profile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Profile Image -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/space_lg">

                <ImageView
                    android:id="@+id/iv_profile_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_image_background"
                    android:clipToOutline="true"
                    android:contentDescription="@string/profile_picture"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/iv_edit_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/space_sm"
                    android:background="@drawable/circle_overlay"
                    android:contentDescription="@string/edit_profile_picture"
                    android:src="@drawable/ic_edit" />
            </FrameLayout>

            <!-- Input Fields -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/first_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_first_name"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/last_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_last_name"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--
                The email identifies the account, so it is shown but not
                editable. Styling it like the other fields keeps the form
                consistent; disabling it says it cannot be changed.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:enabled="false"
                android:hint="@string/email_address"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="textEmailAddress" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/phone_number"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_phone_number"
                android:inputType="phone"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/clinic_code"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_clinic_code"
                android:inputType="numberDecimal"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/address"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_address"
                android:inputType="textPostalAddress"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/date_of_birth"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_dob"
                android:cursorVisible="false"
                android:focusable="false"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="date"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/gender_label"
                android:textColor="@color/dark_gray" />


            <!-- Gender Radio Buttons -->
            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/male"
                    android:textColor="@color/dark_gray" />

                <RadioButton
                    android:id="@+id/rb_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/female"
                    android:textColor="@color/dark_gray" />

                <RadioButton
                    android:id="@+id/rb_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other"
                    android:textColor="@color/dark_gray" />
            </RadioGroup>

            <!--
                Health card. Optional, so it sits after the details the clinic
                cannot book without. Visit day's "Bring your health card" row
                opens this form with the number focused and the section
                scrolled to the top, which is what its id is for.
            -->
            <LinearLayout
                android:id="@+id/health_card_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/edit_profile_card_title"
                    android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/edit_profile_card_body"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium"
                    android:textColor="@color/md_on_surface_variant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:labelFor="@id/et_health_card_number"
                    android:text="@string/edit_profile_card_number"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelLarge"
                    android:textColor="@color/md_on_surface" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_health_card_number"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    app:errorEnabled="true"
                    app:helperText="@string/edit_profile_card_number_help"
                    app:helperTextEnabled="true"
                    app:hintEnabled="false">

                    <!--
                        Text rather than a number keyboard: Quebec numbers
                        start with letters, and Ontario's version code ends
                        with two. No suggestions, so the keyboard does not
                        learn the number.
                    -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_health_card_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="20"
                        android:maxLines="1"
                        android:minHeight="@dimen/control_lg" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:labelFor="@id/et_health_card_province"
                    android:text="@string/edit_profile_card_province"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelLarge"
                    android:textColor="@color/md_on_surface" />

                <!--
                    Picked from a list rather than typed, so it is always one
                    of the thirteen codes the server accepts. Tapping the
                    field or its arrow opens the same list.
                -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_health_card_province"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    app:endIconContentDescription="@string/cd_edit_profile_card_province"
                    app:endIconDrawable="@drawable/ic_chevron_down"
                    app:endIconMode="custom"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_health_card_province"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:maxLines="1"
                        android:minHeight="@dimen/control_lg" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Upload Photo ID Button -->
            <Button
                android:id="@+id/btn_upload_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:backgroundTint="@color/green"
                android:text="@string/upload_id"
                android:textColor="@color/md_on_primary" />

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_file_selected"
                android:textColor="@color/light_blue" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:backgroundTint="@color/green"
                android:text="@string/submit"
                android:textColor="@color/md_on_primary" />
        </LinearLayout>

    </ScrollView>

</FrameLayout>