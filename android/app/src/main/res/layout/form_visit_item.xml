<?xml version="1.0" encoding="utf-8"?>
<!--
    One visit's form on the Forms screen.

    Leads with the doctor and the time, because "which visit is this form
    for?" is the question the screen exists to answer. The tile on the left
    carries the state the way the visit checklist does: the form icon while
    it is owed, a tick once it is sent, so it does not rest on colour alone.

    The whole card is the one thing to tap. The label on the right only
    says what a tap does, so it is kept out of the accessibility tree and
    TalkBack reads the card as one item rather than stopping twice.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_target"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/md_outline_variant"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_md"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <ImageView
            android:id="@+id/form_state_icon"
            android:layout_width="@dimen/control_md"
            android:layout_height="@dimen/control_md"
            android:background="@drawable/tile_brand_soft"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_form"
            app:tint="@color/md_on_primary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/doctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
                tools:text="Dr. Robert Chase · Surgeon" />

            <TextView
                android:id="@+id/visit_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium"
                tools:text="Tomorrow · 10:00 AM" />

            <!-- Same badge as the visit list, so a child's visit reads the same in both. -->
            <TextView
                android:id="@+id/booked_for"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/badge_blue"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                android:textColor="@color/md_on_secondary_container"
                android:visibility="gone"
                tools:text="For Sofia Almeida"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/sent_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
                android:visibility="gone"
                tools:text="Sent Today, 9:14 AM"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:clickable="false"
            android:drawablePadding="@dimen/space_xs"
            android:focusable="false"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:minHeight="@dimen/touch_target"
            android:textAppearance="@style/TextAppearance.Mediconnect.LabelLarge"
            android:textColor="@color/md_primary"
            app:drawableEndCompat="@drawable/ic_chevron_right"
            app:drawableTint="@color/md_primary"
            tools:text="Fill in" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
