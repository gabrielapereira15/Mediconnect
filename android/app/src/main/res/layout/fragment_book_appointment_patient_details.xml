<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    android:padding="@dimen/space_lg"
    tools:context=".fragment.BookAppointmentPatientDetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Selection: Is this appointment for the user or another patient? -->
        <TextView
            android:id="@+id/tv_appointment_for"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/is_this_appointment_for_you_or_another_patient"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

        <RadioGroup
            android:id="@+id/rg_patient_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_for_self"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/for_myself"
                android:textColor="@color/dark_gray" />

            <RadioButton
                android:id="@+id/rb_for_another"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:text="@string/for_another_patient"
                android:textColor="@color/dark_gray" />
        </RadioGroup>

        <!-- Details for "For Myself" -->
        <LinearLayout
            android:id="@+id/layout_self_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_lg"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_patient_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/your_details"
                android:textColor="@color/dark_gray"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

            <TextView
                android:id="@+id/tv_patient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/dark_gray"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            <TextView
                android:id="@+id/tv_patient_dob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/dark_gray"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            <TextView
                android:id="@+id/tv_patient_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:text=""
                android:textColor="@color/dark_gray"
                tools:ignore="TextViewEdits" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            <!-- Text Field for Note -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/note_for_the_doctor"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_self_note"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionDone" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Button -->
            <Button
                android:id="@+id/btn_confirm_self"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:backgroundTint="@color/green"
                android:text="@string/confirm_appointment"
                android:textColor="@color/md_on_primary"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

        </LinearLayout>

        <!-- PreAppointmentForm for "For Another Patient" -->
        <LinearLayout
            android:id="@+id/layout_other_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_lg"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/first_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_first_name"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/last_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_last_name"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--
                Typeable, with the calendar as an alternative rather than the
                only way in: someone who knows the date can enter it faster
                than they can scroll a picker back forty years.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_dob_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/date_of_birth"
                app:endIconContentDescription="@string/dob_pick"
                app:endIconDrawable="@drawable/baseline_calendar_today_24"
                app:endIconMode="custom"
                app:helperText="@string/dob_format_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/et_dob_other"
                    android:padding="@dimen/space_md"
                    android:textColor="@color/dark_gray"
                    android:digits="0123456789-"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="10"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/phone_number"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/tvPhoneNumber"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/additional_notes"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:id="@+id/et_note_other"
                android:padding="@dimen/space_md"
                android:textColor="@color/dark_gray" 
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionDone" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Button -->
            <Button
                android:id="@+id/btn_confirm_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:backgroundTint="@color/green"
                android:text="@string/confirm_appointment"
                android:textColor="@color/md_on_primary"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
