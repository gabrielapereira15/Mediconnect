<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.NotificationsFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:layoutAnimation="@anim/layout_animation_list"
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/space_lg"
        android:clipToPadding="false"
        android:padding="@dimen/space_sm" />


    <com.example.mediconnect_android.view.StateView
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="@dimen/space_lg"
        android:visibility="gone" />

</FrameLayout>