<?xml version="1.0" encoding="utf-8"?>
<!--
    One placeholder row. Mirrors the shape of a real list item — avatar, title,
    subtitle, action — so the layout does not jump when the data arrives.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    app:cardBackgroundColor="@color/md_surface_container"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="0dp"
    app:strokeColor="@color/md_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/skeleton_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="160dp"
                android:layout_height="14dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="96dp"
                android:layout_height="12dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/skeleton_block" />
        </LinearLayout>

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:background="@drawable/skeleton_block" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
