<?xml version="1.0" encoding="utf-8"?>
<!--
    A preference with a switch (board P14).

    The whole row toggles, not just the switch: on a phone the difference
    between those two targets is the difference between a tap and a careful
    tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/switch_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingVertical="@dimen/space_md">

    <ImageView
        android:id="@+id/switch_icon"
        android:layout_width="@dimen/control_md"
        android:layout_height="@dimen/control_md"
        android:background="@drawable/tile_brand_soft"
        android:contentDescription="@null"
        android:padding="@dimen/space_sm"
        android:src="@drawable/ic_bell"
        app:tint="@color/md_on_primary_container" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/switch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
            tools:text="Visit reminders" />

        <TextView
            android:id="@+id/switch_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
            tools:text="The day before and 30 min before" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
