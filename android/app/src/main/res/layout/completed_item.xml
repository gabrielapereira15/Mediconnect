<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:strokeColor="@color/md_outline_variant"
    app:strokeWidth="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Date and Time -->
        <TextView
            android:id="@+id/appointment_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mock_date"
            android:textColor="@color/gray"
            android:textStyle="bold" 
            android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

        <!-- Doctor Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <!-- Doctor's Image -->
            <ImageView
                android:id="@+id/doctor_image"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/round_image_background"
                android:clipToOutline="true"
                android:contentDescription="@string/doctor_name"
                android:scaleType="centerCrop"
                android:src="@drawable/doctorimage"
                android:visibility="visible"
                tools:ignore="UnusedAttribute" />

            <!-- Doctor's Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_sm"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/doctor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_name"
                    android:textColor="@color/dark_gray"
                    android:textStyle="bold" 
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

                <TextView
                    android:id="@+id/doctor_speacialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speacialty_text"
                    android:textColor="@color/gray"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            </LinearLayout>

        </LinearLayout>

        <!-- Buttons for Canceling or Rescheduling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rebook_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/light_gray"
                android:ems="8"
                android:text="@string/re_book"
                android:textColor="@color/dark_gray" />

            <!--
                Shown in place of the button once a review exists. Hiding the
                button alone left a gap that read as the option disappearing,
                so the row now says the review was made and what was given.
            -->
            <LinearLayout
                android:id="@+id/reviewed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_reviewed_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star"
                    app:tint="@color/md_on_secondary_container" />

                <TextView
                    android:id="@+id/reviewed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium"
                    android:textColor="@color/md_on_secondary_container"
                    tools:text="You rated 5.0" />
            </LinearLayout>

            <Button
                android:id="@+id/add_review_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:backgroundTint="@color/green"
                android:ems="8"
                android:text="@string/add_review"
                android:textColor="@color/md_on_primary"
                android:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
