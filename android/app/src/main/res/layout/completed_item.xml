<?xml version="1.0" encoding="utf-8"?>
<!--
    A visit that has happened (board P11).

    Same shape as an upcoming one, so the list does not change language
    between its segments — the date block is quiet rather than brand, and
    the actions are the two things worth doing afterwards: book the same
    doctor again, or say how it went.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_md"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/md_outline_variant"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="52dp"
                android:minHeight="52dp"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs"
                android:background="@drawable/date_badge_quiet"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/badge_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                    android:textColor="@color/md_on_surface"
                    tools:text="Fri" />

                <TextView
                    android:id="@+id/badge_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium"
                    android:textColor="@color/md_on_surface"
                    tools:text="18" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appointment_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
                    tools:text="9:30 AM · Sep" />

                <TextView
                    android:id="@+id/doctor_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
                    tools:text="Dr. Lisa Cuddy · Optometrist" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_neutral"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/completed"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                android:textColor="@color/md_on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rebook_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/control_md"
                android:paddingHorizontal="@dimen/space_sm"
                android:text="@string/review_book_again"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_review_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:minHeight="@dimen/control_md"
                android:paddingHorizontal="@dimen/space_sm"
                android:text="@string/review_leave"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium" />

            <!--
                Replaces the review button once one has been left. The button
                used to simply disappear, which looks the same as the option
                never having been there.
            -->
            <LinearLayout
                android:id="@+id/reviewed_badge"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_md"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:background="@drawable/badge_sun"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/icon_size_badge"
                    android:layout_height="@dimen/icon_size_badge"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star"
                    app:tint="@color/md_rating" />

                <TextView
                    android:id="@+id/reviewed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium"
                    android:textColor="@color/md_on_rating_container"
                    tools:text="You rated 4.5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
