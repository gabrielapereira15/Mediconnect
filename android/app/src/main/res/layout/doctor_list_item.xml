<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Doctor Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_xs"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Doctor's Image -->
            <ImageView
                android:id="@+id/doctor_image"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/space_md"
                android:background="@drawable/round_image_background"
                android:clipToOutline="true"
                android:contentDescription="@string/doctor_name"
                android:scaleType="centerCrop"
                android:src="@drawable/doctorimage"
                android:visibility="visible"
                tools:ignore="UnusedAttribute" />

            <!-- Doctor's Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xs"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/doctor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_name"
                    android:textColor="@color/dark_gray"
                    android:textStyle="bold" 
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

                <TextView
                    android:id="@+id/doctor_speacialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speacialty_text"
                    android:textColor="@color/gray"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_md"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:src="@drawable/baseline_star_rate_24" />

                <TextView
                    android:id="@+id/doctorScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/doctor_score"
                    android:textColor="@color/yellow"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

                <TextView
                    android:id="@+id/reviewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/yellow"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/book_appointment_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:backgroundTint="@color/green"
            android:ems="8"
            android:text="@string/book_appointment_text"
            android:textColor="@color/md_on_primary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
