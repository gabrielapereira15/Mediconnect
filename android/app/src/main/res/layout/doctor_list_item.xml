<?xml version="1.0" encoding="utf-8"?>
<!--
    A doctor on "Find a doctor" (board P04).

    Full width, so there is room for what the Home strip cannot fit: years in
    practice, the review count, and "No reviews yet" in words rather than an
    empty star that reads as a score of zero.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/md_outline_variant"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/doctor_initials"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/avatar_brand_soft"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
                android:textColor="@color/md_on_primary_container"
                tools:text="AV" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/doctor_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
                    tools:text="Dr. Amber Volakis" />

                <TextView
                    android:id="@+id/doctor_specialty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
                    tools:text="General Practitioner · 6 yrs" />

                <LinearLayout
                    android:id="@+id/doctor_rating_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/doctor_star"
                        android:layout_width="@dimen/icon_size_badge"
                        android:layout_height="@dimen/icon_size_badge"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        app:tint="@color/md_rating" />

                    <TextView
                        android:id="@+id/doctor_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
                        tools:text="4.9 (21 reviews)" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/doctor_next_slot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_success"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                android:textColor="@color/md_success"
                tools:text="Today 2:30 PM" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/doctor_book"
                style="@style/Widget.Mediconnect.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_md"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_2xl"
                android:text="@string/doctors_book" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
