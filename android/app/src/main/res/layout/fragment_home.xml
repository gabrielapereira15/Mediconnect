<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/gray_background"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg"
            tools:ignore="UselessParent">

            <!-- Search Bar -->
            <EditText
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="@dimen/space_xl"
                android:background="@drawable/search_bar_background"
                android:drawableStart="@drawable/baseline_search_24"
                android:drawablePadding="@dimen/cardview_default_elevation"
                android:drawableTint="@color/light_blue"
                android:hint="@string/search_for_doctors_or_specialties"
                android:inputType="textPersonName"
                android:paddingStart="@dimen/space_lg"
                android:textColor="@color/dark_gray"
                android:textColorHint="@color/gray"
                tools:ignore="RtlSymmetry" />

            <!-- Specialties Title -->
            <TextView
                android:id="@+id/specialties_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:fontFamily="sans-serif-medium"
                android:text="@string/top_searched_specialties"
                android:textColor="@color/dark_gray"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            <!-- Specialties Icons with Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/space_xs"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Video Visit Specialty -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/specialty_border"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_sm">

                    <ImageView
                        android:id="@+id/optometrist_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="@string/ophthalmologists"
                        android:focusable="true"
                        android:src="@drawable/ophthalmologists" app:tint="@color/md_on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/ophthalmologists"
                        android:textColor="@color/md_on_primary_container"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        android:textSize="12sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

                <!-- Psychiatrist Specialty -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/specialty_border"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_sm">

                    <ImageView
                        android:id="@+id/cardiologist_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="@string/cardiologist"
                        android:focusable="true"
                        android:src="@drawable/cardiologist" app:tint="@color/md_on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="sans-serif"
                        android:text="@string/cardiologist"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/md_on_primary_container"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- OBGYN Specialty -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/specialty_border"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_sm">

                    <ImageView
                        android:id="@+id/obgyn_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="@string/gynecologist"
                        android:focusable="true"
                        android:src="@drawable/gynecologist" app:tint="@color/md_on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="sans-serif"
                        android:text="@string/gynecologist"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/md_on_primary_container"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        android:textSize="12sp"
                        tools:ignore="SmallSp" />

                </LinearLayout>

                <!-- Dermatologist Specialty -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/specialty_border"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_sm">

                    <ImageView
                        android:id="@+id/pediatrician_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="@string/pediatrician"
                        android:focusable="true"
                        android:src="@drawable/baseline_child_care_24" app:tint="@color/md_on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="sans-serif"
                        android:text="@string/pediatrician"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/md_on_primary_container"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        android:textSize="12sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/see_all_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg"
                android:clickable="true"
                android:text="@string/see_all_link"
                android:textColor="@color/light_blue"
                android:textStyle="bold" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

            <!-- Available Doctors Section -->
            <TextView
                android:id="@+id/available_doctors_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:fontFamily="sans-serif-medium"
                android:text="@string/available_doctors_text"
                android:textColor="@color/dark_gray"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            <TextView
                android:id="@+id/unavailable_doctors_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/space_sm"
                android:fontFamily="sans-serif-medium"
                android:text="@string/available_doctors_text"
                android:textColor="@color/dark_gray"
                android:visibility="gone" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />


            <!-- Doctors List (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:layoutAnimation="@anim/layout_animation_list"
                android:id="@+id/recyclerViewDoctors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_sm" />

            <TextView
                android:id="@+id/see_all_doctors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg"
                android:clickable="true"
                android:minWidth="48dp"
                android:text="@string/see_all_link"
                android:textColor="@color/light_blue"
                android:textStyle="bold" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

            <!-- Carousel -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/carouselViewPager"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:elevation="2dp" />

            <!--
                Page indicator. Tells the patient how many adverts there are
                and which one they are on — without it the carousel just moves
                on its own with no sense of position.
            -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/carouselIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/carousel_dot"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="@dimen/space_xs"
                app:tabPaddingStart="@dimen/space_xs" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>