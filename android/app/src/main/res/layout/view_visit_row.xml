<?xml version="1.0" encoding="utf-8"?>
<!--
    One line of the "before you go in" checklist (board P09).

    The leading tile carries the state: a tick once the thing is done, the
    thing's own icon while it is still outstanding. Colour alone would not
    survive a patient who cannot see the difference.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/visit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingVertical="@dimen/space_md">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/control_md"
        android:layout_height="@dimen/control_md"
        android:background="@drawable/tile_brand_soft"
        android:contentDescription="@null"
        android:padding="@dimen/space_sm"
        android:src="@drawable/ic_form"
        app:tint="@color/md_on_primary_container" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
            tools:text="Pre-appointment form" />

        <TextView
            android:id="@+id/row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
            tools:text="Sent yesterday at 8:12 PM" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mediconnect.LabelLarge"
        android:textColor="@color/md_primary"
        android:visibility="gone"
        tools:text="View"
        tools:visibility="visible" />
</LinearLayout>
