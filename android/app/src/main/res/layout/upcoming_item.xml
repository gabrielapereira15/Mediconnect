<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:strokeColor="@color/md_outline_variant"
    app:strokeWidth="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Date and Time -->
        <TextView
            android:id="@+id/appointment_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mock_date"
            android:textColor="@color/gray"
            android:textStyle="bold" 
            android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

        <!-- Doctor Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <!-- Doctor's Image -->
            <ImageView
                android:id="@+id/doctor_image"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/round_image_background"
                android:clipToOutline="true"
                android:contentDescription="@string/doctor_name"
                android:scaleType="centerCrop"
                android:src="@drawable/doctorimage"
                android:visibility="visible"
                tools:ignore="UnusedAttribute" />

            <!-- Doctor's Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_sm"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/doctor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_name"
                    android:textColor="@color/dark_gray"
                    android:textStyle="bold" 
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

                <TextView
                    android:id="@+id/doctor_speacialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speacialty_text"
                    android:textColor="@color/gray"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

                <!--
                    Only shown when the visit is for someone else. Booking for
                    a child or a parent otherwise produced a row identical to
                    your own, with no way to tell them apart.
                -->
                <TextView
                    android:id="@+id/booked_for"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_user"
                    android:drawableTint="@color/md_primary"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium"
                    android:textColor="@color/md_primary"
                    android:visibility="gone"
                    tools:text="For Sofia Almeida"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Remind Me Switch -->
            <Switch
                android:id="@+id/switchRemindMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remind_me"
                android:textColor="@color/gray"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

        </LinearLayout>

        <!-- Buttons for Canceling or Rescheduling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/light_gray"
                android:ems="8"
                android:text="@string/cancel"
                android:textColor="@color/dark_gray" />

            <Button
                android:id="@+id/reschedule_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:backgroundTint="@color/green"
                android:ems="8"
                android:text="@string/reschedule"
                android:textColor="@color/md_on_primary" />
        </LinearLayout>

        <!--
            The waitlist. Offered on the card for the appointment it would
            improve on, because that is the moment someone realises the date
            they were given is further off than they wanted.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/waitlist_button"
            style="@style/Widget.Mediconnect.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/waitlist_join"
            app:icon="@drawable/ic_bell" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
