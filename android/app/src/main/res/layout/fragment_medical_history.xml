<?xml version="1.0" encoding="utf-8"?>
<!--
    Visits (board P08).

    A segmented control rather than tabs. Three underlined tabs across the
    top read as the app's own navigation, which it is not — these are three
    views of one list, and the segmented control says so. "Completed" is
    "Past", because a visit that was missed was not completed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    android:orientation="vertical"
    tools:context=".fragment.MedicalHistoryFragment">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/visit_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_md"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_upcoming"
            style="@style/Widget.Mediconnect.Button.Segmented"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_lg"
            android:layout_weight="1"
            android:text="@string/upcoming" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_past"
            style="@style/Widget.Mediconnect.Button.Segmented"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_lg"
            android:layout_weight="1"
            android:text="@string/visits_past" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_cancelled"
            style="@style/Widget.Mediconnect.Button.Segmented"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_lg"
            android:layout_weight="1"
            android:text="@string/cancelled" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.mediconnect_android.view.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
