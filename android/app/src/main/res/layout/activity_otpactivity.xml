<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    tools:context=".activity.OTPActivity">

    <!-- OTP Instructions -->
    <TextView
        android:id="@+id/otpInstructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="@dimen/space_lg"
        android:gravity="center"
        android:text="@string/enter_the_6_digit_code_sent_to_your_email"
        android:textColor="@color/dark_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" 
        android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />

    <!-- OTP Input Fields -->
    <LinearLayout
        android:id="@+id/otpInputLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/otpInstructions">

        <!-- Six individual fields for OTP digits -->
        <EditText
            android:id="@+id/otpDigit1"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />

        <EditText
            android:id="@+id/otpDigit2"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />

        <EditText
            android:id="@+id/otpDigit3"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />

        <EditText
            android:id="@+id/otpDigit4"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />

        <EditText
            android:id="@+id/otpDigit5"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />

        <EditText
            android:id="@+id/otpDigit6"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.TitleMedium" />
    </LinearLayout>

    <!-- Resend OTP Text -->
    <TextView
        android:id="@+id/resendOtpText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:clickable="true"
        android:gravity="center"
        android:text="@string/resend_otp"
        android:textColor="#1E88E5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/otpInputLayout" 
        android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/verifyButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginEnd="@dimen/space_xl"
        android:backgroundTint="@color/green"
        android:padding="@dimen/space_lg"
        android:text="@string/verify_otp"
        android:textColor="@color/md_on_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/resendOtpText" />

</androidx.constraintlayout.widget.ConstraintLayout>
