<?xml version="1.0" encoding="utf-8"?>
<!--
    Passcode (board P03).

    Six boxes, but one field. The screen this replaces had six separate
    EditTexts wired together by five text watchers: pasting a code put all
    six digits in the first box, autofill from an SMS could not work at
    all, and a backspace on an empty box went nowhere. The boxes here are
    drawn from one input that the whole row focuses.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    tools:context=".activity.OTPActivity">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_margin="@dimen/space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:padding="@dimen/space_md"
        android:src="@drawable/ic_arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/md_on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_2xl"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/tile_brand_soft"
                android:contentDescription="@null"
                android:padding="@dimen/space_lg"
                android:src="@drawable/ic_mail"
                app:tint="@color/md_on_primary_container" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/passcode_title"
                android:textAppearance="@style/TextAppearance.Mediconnect.Display" />

            <TextView
                android:id="@+id/otpInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge"
                android:textColor="@color/md_on_surface_variant"
                tools:text="We sent a 6-digit passcode to demo@mediconnect.ca. It is valid for 10 minutes." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/passcode_label"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                android:textColor="@color/md_on_surface_variant" />

            <!--
                The row is the visible control and the input behind it is
                invisible but focusable, which is what lets one paste or an
                SMS autofill drop six digits in at once.
            -->
            <FrameLayout
                android:id="@+id/otpInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:id="@+id/otp_cells"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal" />

                <EditText
                    android:id="@+id/otp_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="smsOTPCode"
                    android:background="@null"
                    android:contentDescription="@string/passcode_label"
                    android:cursorVisible="false"
                    android:importantForAutofill="yes"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent"
                    android:textCursorDrawable="@null"
                    tools:ignore="LabelFor" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resendOtpText"
                style="@style/Widget.Mediconnect.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:minHeight="@dimen/touch_target"
                android:paddingHorizontal="0dp"
                android:text="@string/passcode_resend" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_different_email"
                style="@style/Widget.Mediconnect.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingHorizontal="0dp"
                android:text="@string/passcode_different_email" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_2xl"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_2xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="@dimen/control_lg"
            android:text="@string/passcode_verify" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/passcode_auto"
            android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
            android:textColor="@color/md_on_surface_subtle" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
