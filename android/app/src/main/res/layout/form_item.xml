<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:strokeColor="@color/md_outline"
    app:strokeWidth="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Title and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- PreAppointmentForm Title -->
            <TextView
                android:id="@+id/form_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/form_title"
                android:textColor="@color/dark_gray"
                android:textStyle="bold" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

            <!-- PreAppointmentForm Status -->
            <TextView
                android:id="@+id/form_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/form_status_mock"
                android:textColor="@color/dark_gray"
                android:visibility="gone" 
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall" />
        </LinearLayout>

        <!-- PreAppointmentForm Description -->
        <TextView
            android:id="@+id/form_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_description_mock"
            android:textColor="@color/gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

        <!-- Edit Button -->
        <Button
            android:id="@+id/edit_form_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/green"
            android:paddingHorizontal="@dimen/space_lg"
            android:text="@string/edit"
            android:textColor="@color/md_on_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
