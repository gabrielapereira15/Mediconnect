<?xml version="1.0" encoding="utf-8"?>
<!--
    Health record (board P12).

    Three kinds of thing a clinic asks for on paper at every visit, grouped
    so a patient can see at a glance what is on file. The list this replaces
    was one flat run of rows with the kind written out on each one, which
    made a record of four items look like a record of one long list.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    tools:context=".fragment.HealthRecordFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_2xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:text="@string/health_intro"
                    android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium"
                    android:textColor="@color/md_on_surface_variant" />

                <!-- ==== Share the summary ============================ -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_lg"
                    android:layout_marginTop="@dimen/space_lg"
                    app:cardBackgroundColor="@color/md_primary_container"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/tile_surface"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_md"
                                android:src="@drawable/ic_share"
                                app:tint="@color/md_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_share_title"
                                    android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
                                    android:textColor="@color/md_on_primary_container" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_share_body"
                                    android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
                                    android:textColor="@color/md_on_primary_container" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_share"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="@dimen/control_md"
                                android:paddingHorizontal="@dimen/space_sm"
                                android:text="@string/health_share"
                                android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium"
                                app:icon="@drawable/ic_share"
                                app:iconSize="18dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_download"
                                style="@style/Widget.Mediconnect.Button.OnTint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:minHeight="@dimen/control_md"
                                android:paddingHorizontal="@dimen/space_sm"
                                android:text="@string/health_download"
                                android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium"
                                app:icon="@drawable/ic_download"
                                app:iconSize="18dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==== The three kinds ============================== -->

                <include
                    android:id="@+id/section_allergies"
                    layout="@layout/view_health_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/section_medications"
                    layout="@layout/view_health_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/section_conditions"
                    layout="@layout/view_health_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:text="@string/health_stopped_note"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                    android:textColor="@color/md_on_surface_subtle" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.example.mediconnect_android.view.StateView
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
