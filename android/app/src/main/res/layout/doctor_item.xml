<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_md"
    android:background="@drawable/doctor_card_background"
    android:orientation="vertical"
    android:padding="@dimen/space_sm">

    <ImageView
        android:id="@+id/doctor_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:background="@drawable/round_image_background"
        android:clipToOutline="true"
        android:contentDescription="@string/doctor_name"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/doctor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/dark_gray"
        android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

    <TextView
        android:id="@+id/doctor_specialty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/gray"
        android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall" />

    <Button
        android:id="@+id/btn_book_appointment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/space_xs"
        android:backgroundTint="@color/green"
        android:text="@string/book_appointment_text"
        android:textColor="@color/md_on_primary"
        android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall" />
</LinearLayout>
