<?xml version="1.0" encoding="utf-8"?>
<!--
    One message (board P13).

    A waitlist offer is tinted and carries its action, because it expires;
    everything else is a plain card. The unread dot is beside the time
    rather than replacing it — "unread" and "when" are different questions.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/message_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/md_outline_variant"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <ImageView
            android:id="@+id/message_icon"
            android:layout_width="@dimen/control_md"
            android:layout_height="@dimen/control_md"
            android:background="@drawable/tile_blue_soft"
            android:contentDescription="@null"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_bell"
            app:tint="@color/md_on_secondary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/message_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Mediconnect.TitleSmall"
                    tools:text="An earlier slot opened up" />

                <TextView
                    android:id="@+id/message_when"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall"
                    android:textColor="@color/md_on_surface_subtle"
                    tools:text="12 min" />

                <View
                    android:id="@+id/message_unread"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/dot_unread"
                    android:contentDescription="@string/messages_unread_dot"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/message_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodySmall"
                tools:text="Dr. Chase can see you Tue 29 Sep at 2:00 PM." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/message_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="@dimen/control_md"
                android:paddingHorizontal="@dimen/space_xl"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelMedium"
                android:visibility="gone"
                tools:text="See offer"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
