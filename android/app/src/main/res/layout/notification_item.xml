<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Notification Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Notification Title -->
            <TextView
                android:id="@+id/notification_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/notification_title_mock"
                android:textColor="@color/dark_gray"
                android:textStyle="bold" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyLarge" />

            <!-- Time -->
            <TextView
                android:id="@+id/notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_notification_mock"
                android:textColor="@color/gray"
                android:textAppearance="@style/TextAppearance.Mediconnect.LabelSmall" />
        </LinearLayout>

        <!-- Notification Body -->
        <TextView
            android:id="@+id/notification_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/notification_body_mock"
            android:textColor="@color/dark_gray"
            android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Read Button -->
            <Button
                android:id="@+id/button_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/light_blue"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:text="@string/read_text"
                android:textColor="@color/dark_gray"
                android:visibility="visible" 
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />

            <!-- Clear Button -->
            <Button
                android:id="@+id/button_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:backgroundTint="@color/green"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:text="@string/clear_text"
                android:textColor="@color/md_on_primary"
                android:textAppearance="@style/TextAppearance.Mediconnect.BodyMedium" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
