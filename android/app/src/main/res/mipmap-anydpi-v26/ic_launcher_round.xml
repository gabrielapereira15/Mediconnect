<?xml version="1.0" encoding="utf-8"?>
<!--
    The MediConnect app icon: the white cross on a teal ground.

    Vector layers rather than the per-density PNGs the project template
    shipped — minSdk is 26, so every device that installs this app uses the
    adaptive icon and the PNGs were never drawn.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
