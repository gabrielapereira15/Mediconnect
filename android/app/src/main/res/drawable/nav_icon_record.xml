<?xml version="1.0" encoding="utf-8"?>
<!--
    The record tab's icon. Outlined normally, filled when the tab is the
    active one — the design system's rule for the bottom navigation, and the
    only thing besides the pill that distinguishes the current tab for
    someone who cannot rely on colour alone.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_record_filled"
        android:state_checked="true" />
    <item android:drawable="@drawable/ic_record" />
</selector>
