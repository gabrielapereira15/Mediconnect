<?xml version="1.0" encoding="utf-8"?>
<!--
    Specialty chip. Uses the primary *container* tone rather than the solid
    primary, so the icon and label keep their contrast in both themes.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_outline" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Main background layer -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_primary_container" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>
