<?xml version="1.0" encoding="utf-8"?>
<!--
    The pill behind the "reviewed" label. Tinted rather than filled so it reads
    as a state the row is in, not as a second button next to "Re-book".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/md_surface_container" />

    <corners android:radius="16dp" />

    <stroke
        android:width="1dp"
        android:color="@color/md_outline_variant" />
</shape>
