<?xml version="1.0" encoding="utf-8"?>
<!--
    One page indicator dot. Wrapped in a layer-list because TabLayout
    stretches a tab background to the tab's full size, which turned a plain
    oval into a vertical bar.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/md_outline" />
        </shape>
    </item>
</layer-list>
