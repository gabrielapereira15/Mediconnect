<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark colour scheme — the 2026 redesign palette.

    Every name in values/colors.xml is redefined here, with the same
    role -> md_* mapping. The accents lighten and take dark text: on a dark
    surface `md_on_primary` is nearly black, because teal light enough to
    read against #0A1519 is far too light to put white on.

    `deep` barely moves between themes on purpose — it is already a dark
    ground, and the home hero and back office sidebar should look like the
    same surface in both.
-->
<resources>

    <!-- ==== Brand ========================================================= -->
    <color name="md_primary">#5BCACE</color>
    <color name="md_on_primary">#02282B</color>
    <color name="md_primary_container">#0E3A3E</color>
    <color name="md_on_primary_container">#B8EDEE</color>
    <color name="md_brand_strong">#8ADDE0</color>

    <color name="md_secondary">#8FB8F6</color>
    <color name="md_on_secondary">#123E80</color>
    <color name="md_secondary_container">#15305A</color>
    <color name="md_on_secondary_container">#D0E1FC</color>

    <color name="md_deep">#0F3440</color>
    <color name="md_on_deep">#E8F4F5</color>
    <color name="md_on_deep_muted">#9CC0C6</color>

    <!-- ==== Surfaces ====================================================== -->
    <color name="md_background">#0A1519</color>
    <color name="md_on_background">#E6EFF1</color>
    <color name="md_surface">#101E23</color>
    <!-- Cards sit above the background rather than below it. -->
    <color name="md_surface_container">#101E23</color>
    <!-- Menus and dialogs rise a step further in the dark theme. -->
    <color name="md_surface_raised">#172A30</color>
    <color name="md_surface_sunken">#1A2E35</color>

    <color name="md_on_surface">#E6EFF1</color>
    <color name="md_on_surface_variant">#A8BBC1</color>
    <color name="md_on_surface_subtle">#8DA2A9</color>

    <color name="md_outline">#5E767F</color>
    <color name="md_outline_variant">#22363D</color>

    <!-- ==== Status ======================================================== -->
    <color name="md_success">#6DD19C</color>
    <color name="md_success_container">#0F3323</color>
    <color name="md_warning">#EFB45A</color>
    <color name="md_warning_container">#3A290C</color>
    <color name="md_error">#FF9C91</color>
    <color name="md_error_container">#461A1A</color>
    <color name="md_on_error">#3A0906</color>

    <color name="md_rating">#F2C160</color>
    <color name="md_rating_container">#3A2C0E</color>
    <color name="md_on_rating_container">#F7DCA0</color>

    <!-- ==== Interaction =================================================== -->
    <color name="md_focus">#5BCACE</color>
    <!-- 60% black, as the design system specifies for the dark theme. -->
    <color name="md_scrim">#99000000</color>


    <!--
        The logo's teal on a `deep` ground. Deliberately the same value in
        both themes: `deep` barely changes between them, so a cross that
        followed the theme would be too dark on it in light mode.
    -->
    <color name="md_logo_on_deep">#5BCACE</color>

    <!-- ==== Legacy aliases ================================================ -->
    <color name="green">@color/md_primary</color>
    <!-- A link or a selected tab, not information: see values/colors.xml. -->
    <color name="light_blue">@color/md_primary</color>
    <color name="dark_gray">@color/md_on_surface</color>
    <color name="gray">@color/md_on_surface_variant</color>
    <!-- A sunken fill, not a line: see the note in values/colors.xml. -->
    <color name="light_gray">@color/md_surface_sunken</color>
    <color name="gray_background">@color/md_background</color>
    <color name="white">@color/md_surface_container</color>
    <color name="black">@color/md_on_surface</color>
    <color name="yellow">@color/md_rating</color>
    <color name="red">@color/md_error</color>

    <color name="nav_item_selected">@color/md_primary</color>
    <color name="nav_item_unselected">@color/md_on_surface_variant</color>

    <color name="transparent">#00000000</color>
    <color name="my_light_primary">@color/md_primary</color>
    <color name="md_panel_on_deep">#17616B</color>
    <color name="md_on_panel_on_deep">#E8F4F5</color>
</resources>
