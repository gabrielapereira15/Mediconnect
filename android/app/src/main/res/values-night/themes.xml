<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark mode.

    This file used to restate the whole theme, which meant every attribute
    added to the light theme silently went missing at night: the night build
    was still asking for Montserrat after the app moved to Plus Jakarta Sans,
    and filter chips and the navigation indicator fell back to Material's own
    colours, which is why a selected chip came out navy instead of teal.

    Only the system bars genuinely differ. Everything else already varies by
    configuration, because the theme names colours and values-night/colors.xml
    redefines those names.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Mediconnectandroid" parent="Base.Theme.Mediconnectandroid">
        <!-- Light icons on dark bars. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
