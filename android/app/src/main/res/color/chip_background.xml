<?xml version="1.0" encoding="utf-8"?>
<!--
    A selected filter chip is filled brand, not merely tinted: hue alone is
    not a safe way to say which of eight chips is active.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/md_primary" android:state_checked="true" />
    <item android:color="@color/md_surface" />
</selector>
